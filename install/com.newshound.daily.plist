<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.newshound.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/.nvm/versions/node/v22.18.0/bin/node</string>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/workspace/newshound/dist/index.js</string>
